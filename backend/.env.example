# =============================================================================
# EduTrack 3D - Environment Variables Configuration
# This file provides a template for configuring application settings.
# Create a copy named .env in the project root directory.
# Update the variables with the appropriate values for your local or production environment.
# Keep sensitive credentials private and never commit the actual .env file to GitHub.
# =============================================================================

# --- JWT Configuration ---
JWT_SECRET_KEY=edutrack_3d_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- Database Mode ---
# Options: 'local' for SQLite or 'azure' for Azure SQL
DATABASE_MODE=local
SQLITE_DATABASE_PATH=./edutrack.db

# --- Azure SQL Database (Optional - for cloud deployment) ---
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=EduTrackDB;Uid=your-user;Pwd=your-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# --- Azure Blob Storage (Optional) ---
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=edutrack-pdfs

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- OCR Configuration ---
TESSERACT_CMD=tesseract

# --- Real-Time GitHub Directory & Log Sync ---
# Required on Render/cloud deployment for automatic commits to GitHub in real-time.
# Generate a Personal Access Token on GitHub (repo scope) and add here and in Render Environment.
GITHUB_TOKEN=
GITHUB_REPO=ankitsingh0311/ChronoXSync
GITHUB_BRANCH=main
